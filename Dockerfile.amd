# syntax=docker/dockerfile:1.4
# ---------------------------------------------------------------------------
# Clair3 GPU Dockerfile (AMD Instinct / ROCm)
#
# Modifications Copyright (C) 2026 Advanced Micro Devices, Inc. All rights reserved.
#
# Requires: amdgpu kernel driver + ROCm-capable GPU on the host (no container
# toolkit). Run with:
#   docker run --device=/dev/kfd --device=/dev/dri --group-add=video clair3:rocm ...
#
# PyTorch is installed from AMD's ROCm wheel index (repo.amd.com). The
# torch[device-gfxNNN] extra pulls both the matching ROCm SDK (rocm-sdk-*) and the
# per-architecture code objects (amd-torch-device-gfxNNN), so the base image is
# plain Ubuntu and needs no system ROCm. The extra is not optional: a bare
# `torch==` installs a PyTorch carrying no kernels for the GPU, and every launch
# then fails with "device kernel image is invalid" (hipErrorInvalidImage).
#
# Build args:
#   --build-arg GFX_ARCH=<arch[,arch]>  GPU architecture(s); default gfx950
#                                       (MI350X/MI355X), gfx942 = MI300X
#   --build-arg ROCM_VERSION=<x.y>      ROCm series; default 10.0 (tested 10.0, 10.1)
#   --build-arg TORCH_VERSION=<x.y>     PyTorch series; default 2.13 (tested 2.13, 2.14)
#   --build-arg BASE_IMAGE=<img>        base image, and hence the Python version
#                                       (ubuntu:24.04 = 3.12, ubuntu:26.04 = 3.14)
# ---------------------------------------------------------------------------
# Base image selects the Python version (ubuntu:24.04 = 3.12, ubuntu:26.04 = 3.14).
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# GPU architecture(s) for the PyTorch [device-gfx*] extras. Accepts one arch or a
# comma/semicolon-separated list (e.g. "gfx942;gfx950") to bundle kernels for
# multiple GPUs in a single image; override with --build-arg.
ARG GFX_ARCH=gfx950

# ROCm and PyTorch series. Both are pinned so a rebuild resolves the same stack.
ARG ROCM_INDEX_URL=https://stable.repo.amd.com/rocm/whl-next/
ARG ROCM_VERSION=10.0
ARG TORCH_VERSION=2.13

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV DEBIAN_FRONTEND=noninteractive
WORKDIR /opt/bin

# System packages:
#  - Build toolchain + the dev libraries htslib and libclair3.so link against
#    (z, bz2, lzma, curl, crypto, deflate) + Boost Graph headers for the
#    debruijn_graph realigner helper.
#  - Runtime tools Clair3 shells out to: samtools, bgzip/tabix, GNU parallel, pigz.
#  - HIP runtime deps not bundled by the wheels: libnuma1 (dlopened by HIP) and
#    libgomp1 (torch's GNU OpenMP runtime). g++ is also required at *runtime*:
#    MIOpen JIT-compiles the pileup RNN kernel and needs the C++ headers.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates wget curl bzip2 xz-utils \
      build-essential autoconf automake libboost-graph-dev \
      zlib1g-dev libbz2-dev liblzma-dev libcurl4-openssl-dev libssl-dev libdeflate-dev \
      python3 python3-venv python3-dev \
      samtools tabix parallel pigz \
      libnuma1 libgomp1 && \
    rm -rf /var/lib/apt/lists/*

# Isolated Python runtime for the image.
ENV VIRTUAL_ENV=/opt/venv
RUN python3 -m venv ${VIRTUAL_ENV}
ENV PATH=${VIRTUAL_ENV}/bin:/opt/bin:${PATH}

# PyTorch (ROCm) + Clair3 Python deps, installed into the venv. The device extras
# resolve the ROCm SDK and the per-arch code objects in a single step -- see the
# header for why a bare `torch==` is not enough.
# setuptools/wheel: Python 3.12+ venvs omit setuptools, which cffi needs to build
# libclair3.so.
RUN set -eu; \
    pip install --no-cache-dir --upgrade pip setuptools wheel; \
    GFX_EXTRAS="$(echo "${GFX_ARCH}" | tr ',;' '\n\n' | sed '/^$/d; s/^/device-/' | paste -sd, -)"; \
    echo "GFX_ARCH=${GFX_ARCH} -> rocm[libraries,devel,${GFX_EXTRAS}]==${ROCM_VERSION}.* torch[${GFX_EXTRAS}]==${TORCH_VERSION}.*"; \
    pip install --no-cache-dir --index-url "${ROCM_INDEX_URL}" \
      "rocm[libraries,devel,${GFX_EXTRAS}]==${ROCM_VERSION}.*" \
      "torch[${GFX_EXTRAS}]==${TORCH_VERSION}.*"; \
    python -c "import importlib.metadata as m; print('installed torch', m.version('torch'), '| rocm', m.version('rocm'))"; \
    pip install --no-cache-dir \
      numpy \
      h5py \
      hdf5plugin \
      numexpr \
      tqdm \
      cffi \
      torchmetrics \
      whatshap

# Clair3 source tree
COPY . /opt/bin

# Build Clair3 native components against the venv Python (htslib static lib +
# LongPhase prebuilt binary + libclair3.so cffi extension), then the realigner/
# debruijn helpers.
RUN make PREFIX=${VIRTUAL_ENV} PYTHON=${VIRTUAL_ENV}/bin/python && \
    cd /opt/bin/preprocess/realign && \
    g++ -std=c++14 -O1 -shared -fPIC -o realigner ssw_cpp.cpp ssw.c realigner.cpp && \
    g++ -std=c++11 -shared -fPIC -o debruijn_graph -O3 debruijn_graph.cpp && \
    rm -rf /opt/bin/samtools-* /opt/bin/longphase-*

# Step 5 in README: install pypy3.11 and mpmath for pypy.
RUN wget -q https://downloads.python.org/pypy/pypy3.11-v7.3.20-linux64.tar.bz2 && \
    tar -xjf pypy3.11-v7.3.20-linux64.tar.bz2 && \
    rm pypy3.11-v7.3.20-linux64.tar.bz2 && \
    ln -sf /opt/bin/pypy3.11-v7.3.20-linux64/bin/pypy3 ${VIRTUAL_ENV}/bin/pypy3 && \
    ln -sf /opt/bin/pypy3.11-v7.3.20-linux64/bin/pypy3 ${VIRTUAL_ENV}/bin/pypy && \
    pypy3 -m ensurepip && \
    pypy3 -m pip install --no-cache-dir mpmath==1.2.1

# Step 6 in README: recursively download pre-trained PyTorch models from a directory URL.
# Pass --build-arg MODEL_CACHE_BUST=$(date +%s) to force a re-download without --no-cache.
ARG CLAIR3_MODELS_URL=https://www.bio8.cs.hku.hk/clair3/clair3_models_pytorch/
# Recent ONT-provided (Rerio-converted) models bundled on top of the HKU baseline.
ARG CLAIR3_RERIO_MODELS_URL=https://www.bio8.cs.hku.hk/clair3/clair3_models_rerio_pytorch/
ARG CLAIR3_BUNDLED_RERIO_MODELS="r1041_e82_400bps_sup_v520 r1041_e82_400bps_hac_v520 r1041_e82_400bps_hac_v600"
ARG MODEL_CACHE_BUST=0
RUN set -eux; \
    echo "MODEL_CACHE_BUST=${MODEL_CACHE_BUST}"; \
    mkdir -p /opt/models /tmp/clair3-models; \
    base_url="${CLAIR3_MODELS_URL%/}"; \
    wget -r -np -nH --cut-dirs=2 -R "index.html*" -P /tmp/clair3-models "${base_url}/"; \
    if [ -d /tmp/clair3-models/clair3_models_pytorch ]; then \
        cp -a /tmp/clair3-models/clair3_models_pytorch/. /opt/models/; \
    else \
        cp -a /tmp/clair3-models/. /opt/models/; \
    fi; \
    rm -rf /tmp/clair3-models; \
    rerio_url="${CLAIR3_RERIO_MODELS_URL%/}"; \
    for m in ${CLAIR3_BUNDLED_RERIO_MODELS}; do \
        echo "Bundling ONT/Rerio model: ${m}"; \
        rm -rf "/opt/models/${m}"; mkdir -p "/opt/models/${m}"; \
        wget -r -np -nd -R "index.html*" -P "/opt/models/${m}" "${rerio_url}/${m}/"; \
        test -f "/opt/models/${m}/pileup.pt" -a -f "/opt/models/${m}/full_alignment.pt"; \
    done
